# Database (Neon PostgreSQL)
DATABASE_URL=

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# Auth.js (Google OAuth)
AUTH_SECRET=          # Generate with: npx auth secret
# Do NOT set AUTH_URL here for local dev — it sends Google sign-in to production.
# Set AUTH_URL only in Vercel Production env vars (https://testimonyarchive.xyz).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Note: OpenAI and AssemblyAI API keys are entered by the user
# in the browser and stored client-side. They are not server env vars.
